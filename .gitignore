*~
plan/
/target
/target-*/
/dist
/corpus
/log
.DS_Store
.claude/
/craft-fonts
# nix build / nix develop
/result
/result-*
# model weights are never committed (SAM 3: docs/ai-masks.md)
*.safetensors
*.safetensors.part

# Python tools import their public operator family.
__pycache__/

# compiled NPU artifacts (ONNX / QNN contexts) are rebuilt by tools/ai scripts
tools/ai/onnx/
tools/ai/__pycache__/
# QNN runtime libraries and context binaries staged by android/build.ps1 (Qualcomm licence)
/android/app/src/sam3/assets/qnn/*.bin
/android/app/src/sam3/assets/qnn/*.so
/android/app/src/sam3/jniLibs/
/android/app/src/mobilesam/assets/qnn/*.bin
/android/app/src/mobilesam/assets/qnn/*.so
/android/app/src/mobilesam/jniLibs/
/android/app/src/lite/jniLibs/
# Qualcomm AI Hub credentials are never committed
.qai_hub/
client.ini
# MobileSAM work products (compiled on the device / exported models)
/tools/ai/mobilesam/ctx/
/tools/ai/mobilesam/*.onnx
/tools/ai/mobilesam/*.dlc
/tools/ai/mobilesam/*.bin
# local build trees
/build/
